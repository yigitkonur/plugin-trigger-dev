{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/session-start.sh\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/marker-gate.sh\" lint --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/codex-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__trigger__(deploy|trigger_task|cancel_run|replay_run|promote_prompt_version|create_prompt_override|update_prompt_override|remove_prompt_override|reactivate_prompt_override|start_agent_chat|write_session_channel|replay_webhook_delivery|create_alert|resolve_alert|initialize_project|create_project_in_org|submit_feedback|generate_webhook_secret|set_webhook_secret)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/trigger-ctx.mjs\" guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
